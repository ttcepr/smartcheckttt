{
  "entities": {
    "Company": {
      "title": "Company",
      "description": "A company or branch in the attendance system.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "The name of the company." },
        "address": { "type": "string", "description": "The physical address of the company." },
        "lat": { "type": "number", "description": "Latitude of the company location." },
        "lng": { "type": "number", "description": "Longitude of the company location." },
        "radius": { "type": "number", "description": "Allowed radius for attendance in meters." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the company was created." }
      },
      "required": ["name", "lat", "lng", "radius"]
    },
    "User": {
      "title": "User",
      "description": "A user in the system (Super Admin, Company Admin, or Employee).",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "description": "The user's email address." },
        "role": { "type": "string", "enum": ["super_admin", "company_admin", "employee"], "description": "The user's role." },
        "companyId": { "type": "string", "description": "The ID of the company the user belongs to." },
        "displayName": { "type": "string", "description": "The user's full name." },
        "mustChangePassword": { "type": "boolean", "description": "Whether the user must change their password on first login." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the user was created." }
      },
      "required": ["email", "role"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "An attendance record (check-in or check-out).",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The ID of the user." },
        "companyId": { "type": "string", "description": "The ID of the company." },
        "type": { "type": "string", "enum": ["check_in", "check_out"], "description": "The type of attendance." },
        "timestamp": { "type": "string", "format": "date-time", "description": "When the attendance was recorded." },
        "location": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "wifiInfo": { "type": "string", "description": "Information about the connected WiFi." },
        "status": { "type": "string", "description": "Status of the attendance (e.g., 'valid', 'invalid')." }
      },
      "required": ["userId", "companyId", "type", "timestamp"]
    },
    "Shift": {
      "title": "Shift",
      "description": "A work shift defined for a company.",
      "type": "object",
      "properties": {
        "companyId": { "type": "string", "description": "The ID of the company." },
        "name": { "type": "string", "description": "The name of the shift." },
        "startTime": { "type": "string", "description": "The start time of the shift (HH:mm)." },
        "endTime": { "type": "string", "description": "The end time of the shift (HH:mm)." },
        "daysOfWeek": { "type": "array", "items": { "type": "number" }, "description": "Days of the week (0-6)." }
      },
      "required": ["companyId", "name", "startTime", "endTime"]
    },
    "Request": {
      "title": "Request",
      "description": "A request submitted by an employee (leave, overtime, etc.).",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The ID of the user." },
        "companyId": { "type": "string", "description": "The ID of the company." },
        "type": { "type": "string", "enum": ["leave", "overtime", "late_early"], "description": "The type of request." },
        "reason": { "type": "string", "description": "The reason for the request." },
        "startDate": { "type": "string", "format": "date", "description": "The start date of the request." },
        "endDate": { "type": "string", "format": "date", "description": "The end date of the request." },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"], "description": "The status of the request." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the request was created." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "When the request was last updated." }
      },
      "required": ["userId", "companyId", "type", "reason", "startDate", "endDate", "status"]
    }
  },
  "firestore": {
    "companies": { "schema": "Company", "description": "Collection of companies." },
    "users": { "schema": "User", "description": "Collection of users." },
    "attendance": { "schema": "Attendance", "description": "Collection of attendance records." },
    "shifts": { "schema": "Shift", "description": "Collection of work shifts." },
    "requests": { "schema": "Request", "description": "Collection of employee requests." }
  }
}
